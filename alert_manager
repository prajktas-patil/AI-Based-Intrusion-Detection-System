"""
alert_manager.py  –  Orchestrates all alerting channels and firewall response.

Channels:
  • Telegram  – rich formatted message with emoji (free, instant)
  • Email     – SMTP with HTML body (Gmail app-password friendly)
  • SMS       – Twilio (CRITICAL only, real API call)

Geo lookup via ipapi.co (free tier, non-blocking).
"""

from __future__ import annotations

import smtplib
import threading
from collections import defaultdict, deque
from datetime import datetime
from email.mime.multipart import MIMEMultipart
from email.mime.text import MIMEText
from typing import Deque, Dict

import requests

from config import settings
from firewall_manager import FirewallManager
from forensic_logger import ForensicLogger
from models import Incident, Severity

# Severity → emoji for Telegram
_SEV_EMOJI: dict[str, str] = {
    "CRITICAL": "🔴",
    "HIGH":     "🟠",
    "MEDIUM":   "🟡",
    "LOW":      "🟢",
}


class AlertManager:

    def __init__(self) -> None:
        self.firewall = FirewallManager()
        self.forensic = ForensicLogger()
        self._last_alert_by_ip: Dict[str, datetime] = {}
        self._alert_counts: Dict[str, int] = defaultdict(int)
        self.recent_incidents: Deque[Incident] = deque(maxlen=5000)

    # ─── main entry point ────────────────────────────────────────────────────

    def handle_incident(self, incident: Incident) -> Incident:
        now    = datetime.utcnow()
        src_ip = incident.event.src_ip

        # Cooldown – don't spam the same IP within cooldown window
        last = self._last_alert_by_ip.get(src_ip)
        if last and (now - last).total_seconds() < settings.alert_cooldown_seconds:
            return incident

        # Enrich
        incident.geo_country, incident.geo_city = self._geo_lookup(src_ip)
        self._last_alert_by_ip[src_ip] = now
        self._alert_counts[src_ip] += 1

        # Persistent attacker upgrade
        if self._alert_counts[src_ip] >= 5:
            incident.attack_pattern = "PERSISTENT_ATTACKER"

        self.recent_incidents.append(incident)
        self.forensic.log_incident(incident)

        # Fire notifications in a background thread (non-blocking)
        threading.Thread(
            target=self._send_all_notifications,
            args=(incident,),
            daemon=True,
        ).start()

        # Firewall block
        if self._should_block(incident):
            result = self.firewall.block_ip(
                src_ip,
                f"{incident.severity.value}:{incident.attack_pattern}",
            )
            incident.blocked = result["blocked"]
            incident.block_expires_at = datetime.fromisoformat(result["expires_at"])

        return incident

    def unblock_ip(self, ip: str) -> bool:
        return self.firewall.unblock_ip(ip)

    def get_blocked_ips(self) -> list[dict]:
        return self.firewall.list_blocked()

    # ─── blocking policy ─────────────────────────────────────────────────────

    def _should_block(self, incident: Incident) -> bool:
        if not settings.auto_block_enabled:
            return False
        if incident.event.src_ip in settings.whitelist_ip_set:
            return False
        return incident.severity.value in settings.block_on_severity_set

    # ─── geo lookup ──────────────────────────────────────────────────────────

    @staticmethod
    def _geo_lookup(ip: str) -> tuple[str, str]:
        """Returns (country, city). Fast non-blocking; fails gracefully."""
        private_prefixes = ("192.168.", "10.", "172.16.", "172.17.",
                            "172.18.", "172.19.", "172.2", "127.", "::1", "0.")
        if any(ip.startswith(p) for p in private_prefixes):
            return "PRIVATE_NET", ""
        try:
            resp = requests.get(
                f"https://ipapi.co/{ip}/json/",
                timeout=2,
                headers={"User-Agent": "SentinelMesh/1.0"},
            )
            if resp.ok:
                data = resp.json()
                return data.get("country_name", "UNKNOWN"), data.get("city", "")
        except Exception:
            pass
        return "UNKNOWN", ""

    # ─── notifications ───────────────────────────────────────────────────────

    def _send_all_notifications(self, incident: Incident) -> None:
        self._send_telegram(incident)
        self._send_email(incident)
        self._send_sms_twilio(incident)

    # ── Telegram ─────────────────────────────────────────────────────────────

    def _send_telegram(self, incident: Incident) -> None:
        if not settings.telegram_enabled:
            return
        token    = settings.telegram_bot_token
        chat_ids = settings.telegram_chat_id_list
        if not token or not chat_ids:
            return

        emoji = _SEV_EMOJI.get(incident.severity.value, "⚠️")
        geo   = incident.geo_country or "UNKNOWN"
        city  = f", {incident.geo_city}" if incident.geo_city else ""
        mitre = f"\n🎯 MITRE: {incident.mitre_tactic}" if incident.mitre_tactic else ""

        text = (
            f"{emoji} *SentinelMesh Alert – {incident.severity.value}*\n"
            f"{'─' * 34}\n"
            f"🔍 Attack : `{incident.attack_type.value if incident.attack_type else 'UNKNOWN'}`\n"
            f"🌐 Source : `{incident.event.src_ip}:{incident.event.src_port}` ({geo}{city})\n"
            f"🎯 Target : `{incident.event.dst_ip}:{incident.event.dst_port}`\n"
            f"📡 Protocol: `{incident.event.protocol}`\n"
            f"📊 Score  : `{incident.anomaly_score:.4f}`  Confidence: `{incident.confidence:.0%}`\n"
            f"🚫 Blocked: `{'YES' if incident.blocked else 'NO'}`"
            f"{mitre}\n"
            f"{'─' * 34}\n"
            f"💡 {incident.recommended_action}"
        )

        url = f"https://api.telegram.org/bot{token}/sendMessage"
        for cid in chat_ids:
            try:
                requests.post(
                    url,
                    json={"chat_id": cid, "text": text, "parse_mode": "Markdown"},
                    timeout=5,
                )
            except Exception:
                continue

    # ── Email ─────────────────────────────────────────────────────────────────

    def _send_email(self, incident: Incident) -> None:
        if not settings.email_enabled:
            return
        if not settings.email_recipient_list or not settings.email_smtp_server:
            return

        sev   = incident.severity.value
        color = {"CRITICAL": "#c0392b", "HIGH": "#e67e22",
                 "MEDIUM":   "#f1c40f", "LOW":  "#27ae60"}.get(sev, "#7f8c8d")

        html = f"""
        <html><body style="font-family:Arial,sans-serif;background:#f4f7ff;padding:20px;">
          <div style="max-width:560px;margin:auto;background:#fff;border-radius:12px;
                      box-shadow:0 4px 16px rgba(0,0,0,.1);overflow:hidden;">
            <div style="background:{color};padding:18px 24px;">
              <h2 style="color:#fff;margin:0;">
                SentinelMesh – {sev} Alert
              </h2>
            </div>
            <div style="padding:24px;">
              <table style="width:100%;border-collapse:collapse;">
                <tr><td style="padding:6px 0;color:#555;width:140px;"><b>Attack Type</b></td>
                    <td>{incident.attack_type.value if incident.attack_type else 'UNKNOWN'}</td></tr>
                <tr><td style="padding:6px 0;color:#555;"><b>Source IP</b></td>
                    <td>{incident.event.src_ip}:{incident.event.src_port}
                    ({incident.geo_country or 'UNKNOWN'})</td></tr>
                <tr><td style="padding:6px 0;color:#555;"><b>Destination</b></td>
                    <td>{incident.event.dst_ip}:{incident.event.dst_port}</td></tr>
                <tr><td style="padding:6px 0;color:#555;"><b>Protocol</b></td>
                    <td>{incident.event.protocol}</td></tr>
                <tr><td style="padding:6px 0;color:#555;"><b>Anomaly Score</b></td>
                    <td>{incident.anomaly_score:.4f} (confidence {incident.confidence:.0%})</td></tr>
                <tr><td style="padding:6px 0;color:#555;"><b>Auto-Blocked</b></td>
                    <td>{'✅ YES' if incident.blocked else '❌ NO'}</td></tr>
                <tr><td style="padding:6px 0;color:#555;"><b>MITRE Tactic</b></td>
                    <td>{incident.mitre_tactic or 'N/A'}</td></tr>
              </table>
              <div style="margin-top:16px;padding:12px;background:#f9f9f9;border-radius:8px;">
                <b>Recommended Action:</b><br>{incident.recommended_action}
              </div>
              <p style="color:#aaa;font-size:11px;margin-top:20px;">
                Incident ID: {incident.incident_id} &nbsp;|&nbsp;
                {incident.timestamp.strftime('%Y-%m-%d %H:%M:%S')} UTC
              </p>
            </div>
          </div>
        </body></html>
        """

        msg = MIMEMultipart("alternative")
        msg["Subject"] = f"[SentinelMesh] {sev} – {incident.attack_type.value if incident.attack_type else 'Anomaly'} Detected"
        msg["From"]    = settings.email_sender
        msg["To"]      = ", ".join(settings.email_recipient_list)
        msg.attach(MIMEText(html, "html"))

        try:
            with smtplib.SMTP(settings.email_smtp_server, settings.email_smtp_port, timeout=6) as srv:
                srv.ehlo()
                srv.starttls()
                srv.login(settings.email_sender, settings.email_password)
                srv.sendmail(settings.email_sender, settings.email_recipient_list, msg.as_string())
        except Exception as exc:
            from utils import append_text
            append_text(settings.firewall_log_path, f"EMAIL_FAILED err={exc}")

    # ── Twilio SMS (CRITICAL only) ────────────────────────────────────────────

    def _send_sms_twilio(self, incident: Incident) -> None:
        """
        Real Twilio SMS integration – fires only for CRITICAL severity.

        Requirements in .env:
            SMS_ENABLED=true
            TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
            TWILIO_AUTH_TOKEN=your_auth_token
            TWILIO_FROM_NUMBER=+1XXXXXXXXXX
            TWILIO_TO_NUMBERS=+91XXXXXXXXXX,+1XXXXXXXXXX
        """
        if not settings.sms_enabled:
            return
        if incident.severity != Severity.CRITICAL:
            return
        if not settings.twilio_sid or not settings.twilio_auth_token:
            return

        body = (
            f"[SentinelMesh] 🔴 CRITICAL ALERT!\n"
            f"Attack : {incident.attack_type.value if incident.attack_type else 'UNKNOWN'}\n"
            f"From   : {incident.event.src_ip} ({incident.geo_country or 'UNKNOWN'})\n"
            f"Target : {incident.event.dst_ip}:{incident.event.dst_port}\n"
            f"Score  : {incident.anomaly_score:.4f}\n"
            f"Blocked: {'YES' if incident.blocked else 'NO'}\n"
            f"Action : {incident.recommended_action[:80]}"
        )

        url = f"https://api.twilio.com/2010-04-01/Accounts/{settings.twilio_sid}/Messages.json"
        auth = (settings.twilio_sid, settings.twilio_auth_token)

        for to_number in settings.twilio_to_list:
            try:
                resp = requests.post(
                    url,
                    data={
                        "From": settings.twilio_from_number,
                        "To":   to_number,
                        "Body": body,
                    },
                    auth=auth,
                    timeout=8,
                )
                if not resp.ok:
                    from utils import append_text
                    append_text(
                        settings.firewall_log_path,
                        f"TWILIO_FAILED to={to_number} status={resp.status_code} body={resp.text[:120]}",
                    )
            except Exception as exc:
                from utils import append_text
                append_text(settings.firewall_log_path, f"TWILIO_ERROR to={to_number} err={exc}")
